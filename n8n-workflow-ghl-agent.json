        "description": "Busca contactos en GoHighLevel. Puedes buscar por nombre, email, teléfono o tags.",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": ""
        },
        "specifyInputSchema": true,
        "jsonSchemaExample": "{\n  \"query\": \"john\",\n  \"limit\": 10\n}"
      },
