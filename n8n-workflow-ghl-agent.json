      "id": "trigger-chat",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "webhookId": "ghl-agent-chat"
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Eres un asistente de CRM experto en GoHighLevel. Tienes acceso a herramientas para gestionar contactos, conversaciones, oportunidades, calendarios, facturas y más.\n\nCuando el usuario te pida información sobre contactos, oportunidades, citas u otras entidades de GHL, usa las herramientas disponibles para obtener la información.\n\nSiempre responde en español a menos que el usuario hable en otro idioma.\n\nHerramientas disponibles:\n- search_contacts: Buscar contactos\n- get_contact: Obtener detalles de un contacto\n- create_contact: Crear nuevo contacto\n- search_opportunities: Buscar oportunidades de venta\n- get_pipelines: Obtener pipelines de ventas\n- search_conversations: Buscar conversaciones\n- send_sms: Enviar SMS a un contacto\n- send_email: Enviar email a un contacto\n- get_calendars: Obtener calendarios\n- create_appointment: Crear una cita"
        }
      },
      "id": "agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [220, 0]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "openai-chat",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [220, 200],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
