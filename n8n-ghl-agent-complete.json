        "url": "https://gohighlevel-mcp-jzus.onrender.com/call-tool",
        "sendHeaders": true,
        "parametersJson": "={\"Content-Type\": \"application/json\"}",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tool: 'get_contact', arguments: { contactId: $fromAI('contactId', 'ID del contacto a obtener') } }) }}"
      },
      "id": "tool-get-contact",
      "name": "Get Contact",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [360, 200]
    },
    {
